APP_ENV=development
DEBUG=true

DATABASE_URL=sqlite:///./data/bevims.db

MQTT_ENABLED=false
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org

MAPBOX_TOKEN=
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

SIMULATION_MODE=true
SIMULATION_VEHICLES=5
DEMO_AUTOPLAY=true

WEBSOCKET_UPDATE_INTERVAL=1

# Sent by hardware as header  X-API-Key  (change this!)
TELEMETRY_API_KEY=bevims-demo-key
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DEVIATION_DISTANCE_THRESHOLD=100
DEVIATION_TIME_THRESHOLD=15
OFFLINE_AFTER_SECONDS=10
